# Copia este fichero a backend.hcl y rellena los valores reales
# (bucket es un output de infra/terraform-bootstrap:
# `terraform output tfstate_bucket_name`).
#
# backend.hcl NO se versiona (ver .gitignore en la raiz del proyecto):
# en equipo cada persona/entorno podria apuntar a un bucket distinto,
# y el bloque backend "s3" {} de main.tf se deja vacio a proposito
# porque no admite variables ni interpolacion.
#
# use_lockfile = locking nativo del backend S3 (desde Terraform 1.10):
# usa una escritura condicional dentro del propio bucket en vez de una
# tabla DynamoDB aparte. No hace falta mas infraestructura para el lock.
#
# Uso:
#   terraform init -backend-config=backend.hcl

bucket       = "task-tracker-tfstate-<account-id>"
key          = "aws-devops-showcase/terraform.tfstate"
region       = "eu-west-1"
use_lockfile = true
encrypt      = true
